{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Totality",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#000d11",
    "editor.foreground": "#728586",
    "editorLineNumber.foreground": "#436069",
    "editorLineNumber.activeForeground": "#829291",
    "editor.lineHighlightBackground": "#001b21",
    "editor.selectionBackground": "#082329",
    "editor.inactiveSelectionBackground": "#001b21",
    "editor.selectionHighlightBackground": "#56899724",
    "editor.wordHighlightBackground": "#5689971f",
    "editor.wordHighlightStrongBackground": "#5689972e",
    "editor.findMatchBackground": "#56899757",
    "editor.findMatchHighlightBackground": "#5689972e",
    "editorCursor.foreground": "#829291",
    "editorWhitespace.foreground": "#0d272e",
    "editorIndentGuide.background1": "#062127",
    "editorIndentGuide.activeIndentGuide1": "#436069",
    "editorRuler.foreground": "#001b21",
    "editorBracketMatch.background": "#5689972e",
    "editorBracketMatch.border": "#568997",
    "editorGutter.modifiedBackground": "#896767",
    "editorGutter.addedBackground": "#7f8375",
    "editorGutter.deletedBackground": "#675f58",
    "editorError.foreground": "#675f58",
    "editorWarning.foreground": "#896767",
    "editorInfo.foreground": "#568997",
    "editorWidget.background": "#0c1518",
    "editorWidget.border": "#0d272e",
    "editorSuggestWidget.selectedBackground": "#001b21",
    "editorHoverWidget.background": "#0c1518",
    "editorHoverWidget.border": "#0d272e",
    "peekViewEditor.background": "#00090c",
    "peekViewResult.background": "#000000",
    "diffEditor.insertedTextBackground": "#7f83751f",
    "diffEditor.removedTextBackground": "#675f581f",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#728586",
    "sideBar.border": "#041f25",
    "sideBarSectionHeader.background": "#000000",
    "sideBarSectionHeader.foreground": "#829291",
    "sideBarTitle.foreground": "#829291",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#829291",
    "activityBar.inactiveForeground": "#436069",
    "activityBar.border": "#041f25",
    "activityBarBadge.background": "#568997",
    "activityBarBadge.foreground": "#000d11",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#728586",
    "statusBar.border": "#041f25",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#896767",
    "statusBar.debuggingForeground": "#000d11",
    "statusBarItem.remoteBackground": "#568997",
    "statusBarItem.remoteForeground": "#000d11",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#728586",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#436069",
    "titleBar.border": "#041f25",
    "tab.activeBackground": "#000d11",
    "tab.activeForeground": "#829291",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#436069",
    "tab.border": "#041f25",
    "tab.activeBorderTop": "#568997",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.noTabsBackground": "#000000",
    "editorGroup.border": "#041f25",
    "panel.background": "#000d11",
    "panel.border": "#041f25",
    "panelTitle.activeForeground": "#829291",
    "panelTitle.inactiveForeground": "#436069",
    "terminal.background": "#000d11",
    "terminal.foreground": "#728586",
    "terminalCursor.foreground": "#829291",
    "terminal.ansiBlack": "#001b21",
    "terminal.ansiBrightBlack": "#436069",
    "terminal.ansiRed": "#675f58",
    "terminal.ansiBrightRed": "#675f58",
    "terminal.ansiGreen": "#7f8375",
    "terminal.ansiBrightGreen": "#4f6d76",
    "terminal.ansiYellow": "#896767",
    "terminal.ansiBrightYellow": "#728586",
    "terminal.ansiBlue": "#787b85",
    "terminal.ansiBrightBlue": "#829291",
    "terminal.ansiMagenta": "#634d60",
    "terminal.ansiBrightMagenta": "#896767",
    "terminal.ansiCyan": "#568997",
    "terminal.ansiBrightCyan": "#dfd6c4",
    "terminal.ansiWhite": "#dfd6c4",
    "terminal.ansiBrightWhite": "#ede4d2",
    "list.activeSelectionBackground": "#001b21",
    "list.activeSelectionForeground": "#829291",
    "list.inactiveSelectionBackground": "#070707",
    "list.hoverBackground": "#050505",
    "list.highlightForeground": "#568997",
    "list.errorForeground": "#675f58",
    "list.warningForeground": "#896767",
    "input.background": "#00090c",
    "input.foreground": "#728586",
    "input.border": "#0d272e",
    "input.placeholderForeground": "#436069",
    "inputOption.activeBorder": "#568997",
    "dropdown.background": "#0c1518",
    "dropdown.border": "#0d272e",
    "badge.background": "#568997",
    "badge.foreground": "#000d11",
    "button.background": "#568997",
    "button.foreground": "#000d11",
    "button.hoverBackground": "#6396a4",
    "focusBorder": "#56899799",
    "scrollbarSlider.background": "#7285861f",
    "scrollbarSlider.hoverBackground": "#72858633",
    "scrollbarSlider.activeBackground": "#7285864c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#568997",
    "breadcrumb.foreground": "#436069",
    "breadcrumb.focusForeground": "#829291",
    "menu.background": "#0c1518",
    "menu.foreground": "#728586",
    "gitDecoration.modifiedResourceForeground": "#896767",
    "gitDecoration.addedResourceForeground": "#7f8375",
    "gitDecoration.deletedResourceForeground": "#675f58",
    "gitDecoration.untrackedResourceForeground": "#634d60",
    "gitDecoration.ignoredResourceForeground": "#436069",
    "textLink.foreground": "#568997",
    "textLink.activeForeground": "#6699a7"
  },
  "semanticTokenColors": {
    "function": "#787b85",
    "method": "#787b85",
    "class": "#896767",
    "type": "#896767",
    "interface": "#896767",
    "enum": "#896767",
    "string": "#568997",
    "number": "#896767",
    "keyword": "#7f8375",
    "variable": "#728586",
    "parameter": "#728586",
    "property": "#896767",
    "namespace": "#634d60",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#436069",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#4f6d76"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#568997"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#568997"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#7f8375"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#728586"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#787b85"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#728586"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#728586"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#634d60"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#675f58"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#634d60"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#675f58"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#675f58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#568997",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#829291",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#829291",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#829291",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#787b85"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#829291"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#728586"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#436069",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#7f8375"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#675f58"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#896767"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#634d60"
      }
    }
  ]
}