{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Totality",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#000d11",
    "editor.foreground": "#7c8588",
    "editorLineNumber.foreground": "#436069",
    "editorLineNumber.activeForeground": "#899295",
    "editor.lineHighlightBackground": "#001b21",
    "editor.selectionBackground": "#082329",
    "editor.inactiveSelectionBackground": "#001b21",
    "editor.selectionHighlightBackground": "#438e9d24",
    "editor.wordHighlightBackground": "#438e9d1f",
    "editor.wordHighlightStrongBackground": "#438e9d2e",
    "editor.findMatchBackground": "#438e9d57",
    "editor.findMatchHighlightBackground": "#438e9d2e",
    "editorCursor.foreground": "#899295",
    "editorWhitespace.foreground": "#0d272e",
    "editorIndentGuide.background1": "#062127",
    "editorIndentGuide.activeIndentGuide1": "#436069",
    "editorRuler.foreground": "#001b21",
    "editorBracketMatch.background": "#438e9d2e",
    "editorBracketMatch.border": "#438e9d",
    "editorGutter.modifiedBackground": "#98708d",
    "editorGutter.addedBackground": "#7e855e",
    "editorGutter.deletedBackground": "#9d6a5e",
    "editorError.foreground": "#9d6a5e",
    "editorWarning.foreground": "#98708d",
    "editorInfo.foreground": "#438e9d",
    "editorWidget.background": "#0c1518",
    "editorWidget.border": "#0d272e",
    "editorSuggestWidget.selectedBackground": "#001b21",
    "editorHoverWidget.background": "#0c1518",
    "editorHoverWidget.border": "#0d272e",
    "peekViewEditor.background": "#00090c",
    "peekViewResult.background": "#000000",
    "diffEditor.insertedTextBackground": "#7e855e1f",
    "diffEditor.removedTextBackground": "#9d6a5e1f",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#7c8588",
    "sideBar.border": "#041f25",
    "sideBarSectionHeader.background": "#000000",
    "sideBarSectionHeader.foreground": "#899295",
    "sideBarTitle.foreground": "#899295",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#899295",
    "activityBar.inactiveForeground": "#436069",
    "activityBar.border": "#041f25",
    "activityBarBadge.background": "#438e9d",
    "activityBarBadge.foreground": "#000d11",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#7c8588",
    "statusBar.border": "#041f25",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#98708d",
    "statusBar.debuggingForeground": "#000d11",
    "statusBarItem.remoteBackground": "#438e9d",
    "statusBarItem.remoteForeground": "#000d11",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#7c8588",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#436069",
    "titleBar.border": "#041f25",
    "tab.activeBackground": "#000d11",
    "tab.activeForeground": "#899295",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#436069",
    "tab.border": "#041f25",
    "tab.activeBorderTop": "#438e9d",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.noTabsBackground": "#000000",
    "editorGroup.border": "#041f25",
    "panel.background": "#000d11",
    "panel.border": "#041f25",
    "panelTitle.activeForeground": "#899295",
    "panelTitle.inactiveForeground": "#436069",
    "terminal.background": "#000d11",
    "terminal.foreground": "#7c8588",
    "terminalCursor.foreground": "#899295",
    "terminal.ansiBlack": "#001b21",
    "terminal.ansiBrightBlack": "#436069",
    "terminal.ansiRed": "#9d6a5e",
    "terminal.ansiBrightRed": "#9d6a5e",
    "terminal.ansiGreen": "#7e855e",
    "terminal.ansiBrightGreen": "#4f6d76",
    "terminal.ansiYellow": "#98708d",
    "terminal.ansiBrightYellow": "#7c8588",
    "terminal.ansiBlue": "#6e839c",
    "terminal.ansiBrightBlue": "#899295",
    "terminal.ansiMagenta": "#75739c",
    "terminal.ansiBrightMagenta": "#98708d",
    "terminal.ansiCyan": "#438e9d",
    "terminal.ansiBrightCyan": "#dfd6c4",
    "terminal.ansiWhite": "#dfd6c4",
    "terminal.ansiBrightWhite": "#ede4d2",
    "list.activeSelectionBackground": "#001b21",
    "list.activeSelectionForeground": "#899295",
    "list.inactiveSelectionBackground": "#070707",
    "list.hoverBackground": "#050505",
    "list.highlightForeground": "#438e9d",
    "list.errorForeground": "#9d6a5e",
    "list.warningForeground": "#98708d",
    "input.background": "#00090c",
    "input.foreground": "#7c8588",
    "input.border": "#0d272e",
    "input.placeholderForeground": "#436069",
    "inputOption.activeBorder": "#438e9d",
    "dropdown.background": "#0c1518",
    "dropdown.border": "#0d272e",
    "badge.background": "#438e9d",
    "badge.foreground": "#000d11",
    "button.background": "#438e9d",
    "button.foreground": "#000d11",
    "button.hoverBackground": "#519baa",
    "focusBorder": "#438e9d99",
    "scrollbarSlider.background": "#7c85881f",
    "scrollbarSlider.hoverBackground": "#7c858833",
    "scrollbarSlider.activeBackground": "#7c85884c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#438e9d",
    "breadcrumb.foreground": "#436069",
    "breadcrumb.focusForeground": "#899295",
    "menu.background": "#0c1518",
    "menu.foreground": "#7c8588",
    "gitDecoration.modifiedResourceForeground": "#98708d",
    "gitDecoration.addedResourceForeground": "#7e855e",
    "gitDecoration.deletedResourceForeground": "#9d6a5e",
    "gitDecoration.untrackedResourceForeground": "#75739c",
    "gitDecoration.ignoredResourceForeground": "#436069",
    "textLink.foreground": "#438e9d",
    "textLink.activeForeground": "#549ead"
  },
  "semanticTokenColors": {
    "function": "#6e839c",
    "method": "#6e839c",
    "class": "#98708d",
    "type": "#98708d",
    "interface": "#98708d",
    "enum": "#98708d",
    "string": "#438e9d",
    "number": "#98708d",
    "keyword": "#7e855e",
    "variable": "#7c8588",
    "parameter": "#7c8588",
    "property": "#98708d",
    "namespace": "#75739c",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#436069",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#4f6d76"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#438e9d"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#438e9d"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#7e855e"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#7c8588"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#6e839c"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#7c8588"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#7c8588"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#75739c"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#9d6a5e"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#75739c"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#9d6a5e"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#9d6a5e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#438e9d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#899295",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#899295",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#899295",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#6e839c"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#899295"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#7c8588"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#436069",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#436069"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#7e855e"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#9d6a5e"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#98708d"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#75739c"
      }
    }
  ]
}