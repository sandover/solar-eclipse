{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Umbra",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#25222c",
    "editor.foreground": "#9e9da1",
    "editorLineNumber.foreground": "#6c6a69",
    "editorLineNumber.activeForeground": "#aba9ae",
    "editor.lineHighlightBackground": "#302c38",
    "editor.selectionBackground": "#393541",
    "editor.inactiveSelectionBackground": "#302c38",
    "editor.selectionHighlightBackground": "#86a2aa24",
    "editor.wordHighlightBackground": "#86a2aa1f",
    "editor.wordHighlightStrongBackground": "#86a2aa2e",
    "editor.findMatchBackground": "#86a2aa57",
    "editor.findMatchHighlightBackground": "#86a2aa2e",
    "editorCursor.foreground": "#aba9ae",
    "editorWhitespace.foreground": "#3d3946",
    "editorIndentGuide.background1": "#37323f",
    "editorIndentGuide.activeIndentGuide1": "#6c6a69",
    "editorRuler.foreground": "#302c38",
    "editorBracketMatch.background": "#86a2aa2e",
    "editorBracketMatch.border": "#86a2aa",
    "editorGutter.modifiedBackground": "#6a98a5",
    "editorGutter.addedBackground": "#809cb4",
    "editorGutter.deletedBackground": "#7797b6",
    "editorError.foreground": "#7797b6",
    "editorWarning.foreground": "#6a98a5",
    "editorInfo.foreground": "#86a2aa",
    "editorWidget.background": "#2c2933",
    "editorWidget.border": "#3d3946",
    "editorSuggestWidget.selectedBackground": "#302c38",
    "editorHoverWidget.background": "#2c2933",
    "editorHoverWidget.border": "#3d3946",
    "peekViewEditor.background": "#23202a",
    "peekViewResult.background": "#1d1a24",
    "diffEditor.insertedTextBackground": "#809cb41f",
    "diffEditor.removedTextBackground": "#7797b61f",
    "sideBar.background": "#1d1a24",
    "sideBar.foreground": "#9e9da1",
    "sideBar.border": "#34303c",
    "sideBarSectionHeader.background": "#1d1a24",
    "sideBarSectionHeader.foreground": "#aba9ae",
    "sideBarTitle.foreground": "#aba9ae",
    "activityBar.background": "#1d1a24",
    "activityBar.foreground": "#aba9ae",
    "activityBar.inactiveForeground": "#6c6a69",
    "activityBar.border": "#34303c",
    "activityBarBadge.background": "#86a2aa",
    "activityBarBadge.foreground": "#25222c",
    "statusBar.background": "#1d1a24",
    "statusBar.foreground": "#9e9da1",
    "statusBar.border": "#34303c",
    "statusBar.noFolderBackground": "#1d1a24",
    "statusBar.debuggingBackground": "#6a98a5",
    "statusBar.debuggingForeground": "#25222c",
    "statusBarItem.remoteBackground": "#86a2aa",
    "statusBarItem.remoteForeground": "#25222c",
    "titleBar.activeBackground": "#1d1a24",
    "titleBar.activeForeground": "#9e9da1",
    "titleBar.inactiveBackground": "#1d1a24",
    "titleBar.inactiveForeground": "#6c6a69",
    "titleBar.border": "#34303c",
    "tab.activeBackground": "#25222c",
    "tab.activeForeground": "#aba9ae",
    "tab.inactiveBackground": "#1d1a24",
    "tab.inactiveForeground": "#6c6a69",
    "tab.border": "#34303c",
    "tab.activeBorderTop": "#86a2aa",
    "editorGroupHeader.tabsBackground": "#1d1a24",
    "editorGroupHeader.noTabsBackground": "#1d1a24",
    "editorGroup.border": "#34303c",
    "panel.background": "#25222c",
    "panel.border": "#34303c",
    "panelTitle.activeForeground": "#aba9ae",
    "panelTitle.inactiveForeground": "#6c6a69",
    "terminal.background": "#25222c",
    "terminal.foreground": "#9e9da1",
    "terminalCursor.foreground": "#aba9ae",
    "terminal.ansiBlack": "#302c38",
    "terminal.ansiBrightBlack": "#6c6a69",
    "terminal.ansiRed": "#7797b6",
    "terminal.ansiBrightRed": "#7797b6",
    "terminal.ansiGreen": "#809cb4",
    "terminal.ansiBrightGreen": "#797776",
    "terminal.ansiYellow": "#6a98a5",
    "terminal.ansiBrightYellow": "#9e9da1",
    "terminal.ansiBlue": "#8499a5",
    "terminal.ansiBrightBlue": "#aba9ae",
    "terminal.ansiMagenta": "#788e9f",
    "terminal.ansiBrightMagenta": "#6a98a5",
    "terminal.ansiCyan": "#86a2aa",
    "terminal.ansiBrightCyan": "#e6e7fa",
    "terminal.ansiWhite": "#e6e7fa",
    "terminal.ansiBrightWhite": "#f6f6ff",
    "list.activeSelectionBackground": "#302c38",
    "list.activeSelectionForeground": "#aba9ae",
    "list.inactiveSelectionBackground": "#211e28",
    "list.hoverBackground": "#201d27",
    "list.highlightForeground": "#86a2aa",
    "list.errorForeground": "#7797b6",
    "list.warningForeground": "#6a98a5",
    "input.background": "#23202a",
    "input.foreground": "#9e9da1",
    "input.border": "#3d3946",
    "input.placeholderForeground": "#6c6a69",
    "inputOption.activeBorder": "#86a2aa",
    "dropdown.background": "#2c2933",
    "dropdown.border": "#3d3946",
    "badge.background": "#86a2aa",
    "badge.foreground": "#25222c",
    "button.background": "#86a2aa",
    "button.foreground": "#25222c",
    "button.hoverBackground": "#93afb8",
    "focusBorder": "#86a2aa99",
    "scrollbarSlider.background": "#9e9da11f",
    "scrollbarSlider.hoverBackground": "#9e9da133",
    "scrollbarSlider.activeBackground": "#9e9da14c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#86a2aa",
    "breadcrumb.foreground": "#6c6a69",
    "breadcrumb.focusForeground": "#aba9ae",
    "menu.background": "#2c2933",
    "menu.foreground": "#9e9da1",
    "gitDecoration.modifiedResourceForeground": "#6a98a5",
    "gitDecoration.addedResourceForeground": "#809cb4",
    "gitDecoration.deletedResourceForeground": "#7797b6",
    "gitDecoration.untrackedResourceForeground": "#788e9f",
    "gitDecoration.ignoredResourceForeground": "#6c6a69",
    "textLink.foreground": "#8cb6b4",
    "textLink.activeForeground": "#9cc6c4",
    "textBlockQuote.background": "#b0a08314",
    "textBlockQuote.border": "#b0a083",
    "textCodeBlock.background": "#302c38",
    "textSeparator.foreground": "#8cb6b46b",
    "textPreformat.foreground": "#d7ba7d",
    "textPreformat.background": "#302c38",
    "widget.border": "#3d3946"
  },
  "semanticTokenColors": {
    "function": "#8499a5",
    "method": "#8499a5",
    "class": "#6a98a5",
    "type": "#6a98a5",
    "interface": "#6a98a5",
    "enum": "#6a98a5",
    "string": "#86a2aa",
    "number": "#6a98a5",
    "keyword": "#809cb4",
    "variable": "#9e9da1",
    "parameter": "#9e9da1",
    "property": "#6a98a5",
    "namespace": "#788e9f",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#6c6a69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#797776"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#86a2aa"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#86a2aa"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#809cb4"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#8499a5"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#788e9f"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#788e9f"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#7797b6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#aba9ae",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#aba9ae",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#86a2aa",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name, markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#8499a5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#aba9ae",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#aba9ae",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#8499a5"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#aba9ae"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6c6a69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#809cb4"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#788e9f"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#9aadb8"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#b0a083"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name",
      "settings": {
        "foreground": "#b4afb5"
      }
    },
    {
      "scope": "markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#b4afb5"
      }
    },
    {
      "scope": "markup.heading.5, markup.heading.5 entity.name",
      "settings": {
        "foreground": "#aba9ae"
      }
    },
    {
      "scope": "markup.heading.6, markup.heading.6 entity.name",
      "settings": {
        "foreground": "#aba9ae"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#aba9ae"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#9e9da1"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#97aaa9"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#a39b91"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#a39b91"
      }
    }
  ]
}