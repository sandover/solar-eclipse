{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Umbra",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1d1b19",
    "editor.foreground": "#9f9e9a",
    "editorLineNumber.foreground": "#6c6a69",
    "editorLineNumber.activeForeground": "#acaba7",
    "editor.lineHighlightBackground": "#282523",
    "editor.selectionBackground": "#312d2b",
    "editor.inactiveSelectionBackground": "#282523",
    "editor.selectionHighlightBackground": "#6ca6bd24",
    "editor.wordHighlightBackground": "#6ca6bd1f",
    "editor.wordHighlightStrongBackground": "#6ca6bd2e",
    "editor.findMatchBackground": "#6ca6bd57",
    "editor.findMatchHighlightBackground": "#6ca6bd2e",
    "editorCursor.foreground": "#acaba7",
    "editorWhitespace.foreground": "#353230",
    "editorIndentGuide.background1": "#2e2b29",
    "editorIndentGuide.activeIndentGuide1": "#6c6a69",
    "editorRuler.foreground": "#282523",
    "editorBracketMatch.background": "#6ca6bd2e",
    "editorBracketMatch.border": "#6ca6bd",
    "editorGutter.modifiedBackground": "#6a98a5",
    "editorGutter.addedBackground": "#809cb4",
    "editorGutter.deletedBackground": "#7797b6",
    "editorError.foreground": "#7797b6",
    "editorWarning.foreground": "#6a98a5",
    "editorInfo.foreground": "#6ca6bd",
    "editorWidget.background": "#24211f",
    "editorWidget.border": "#353230",
    "editorSuggestWidget.selectedBackground": "#282523",
    "editorHoverWidget.background": "#24211f",
    "editorHoverWidget.border": "#353230",
    "peekViewEditor.background": "#1b1917",
    "peekViewResult.background": "#151310",
    "diffEditor.insertedTextBackground": "#809cb41f",
    "diffEditor.removedTextBackground": "#7797b61f",
    "sideBar.background": "#151310",
    "sideBar.foreground": "#9f9e9a",
    "sideBar.border": "#2c2927",
    "sideBarSectionHeader.background": "#151310",
    "sideBarSectionHeader.foreground": "#acaba7",
    "sideBarTitle.foreground": "#acaba7",
    "activityBar.background": "#151310",
    "activityBar.foreground": "#acaba7",
    "activityBar.inactiveForeground": "#6c6a69",
    "activityBar.border": "#2c2927",
    "activityBarBadge.background": "#6ca6bd",
    "activityBarBadge.foreground": "#1d1b19",
    "statusBar.background": "#151310",
    "statusBar.foreground": "#9f9e9a",
    "statusBar.border": "#2c2927",
    "statusBar.noFolderBackground": "#151310",
    "statusBar.debuggingBackground": "#6a98a5",
    "statusBar.debuggingForeground": "#1d1b19",
    "statusBarItem.remoteBackground": "#6ca6bd",
    "statusBarItem.remoteForeground": "#1d1b19",
    "titleBar.activeBackground": "#151310",
    "titleBar.activeForeground": "#9f9e9a",
    "titleBar.inactiveBackground": "#151310",
    "titleBar.inactiveForeground": "#6c6a69",
    "titleBar.border": "#2c2927",
    "tab.activeBackground": "#1d1b19",
    "tab.activeForeground": "#acaba7",
    "tab.inactiveBackground": "#151310",
    "tab.inactiveForeground": "#6c6a69",
    "tab.border": "#2c2927",
    "tab.activeBorderTop": "#6ca6bd",
    "editorGroupHeader.tabsBackground": "#151310",
    "editorGroupHeader.noTabsBackground": "#151310",
    "editorGroup.border": "#2c2927",
    "panel.background": "#1d1b19",
    "panel.border": "#2c2927",
    "panelTitle.activeForeground": "#acaba7",
    "panelTitle.inactiveForeground": "#6c6a69",
    "terminal.background": "#1d1b19",
    "terminal.foreground": "#9f9e9a",
    "terminalCursor.foreground": "#acaba7",
    "terminal.ansiBlack": "#282523",
    "terminal.ansiBrightBlack": "#6c6a69",
    "terminal.ansiRed": "#7797b6",
    "terminal.ansiBrightRed": "#7797b6",
    "terminal.ansiGreen": "#809cb4",
    "terminal.ansiBrightGreen": "#797776",
    "terminal.ansiYellow": "#6a98a5",
    "terminal.ansiBrightYellow": "#9f9e9a",
    "terminal.ansiBlue": "#8499a5",
    "terminal.ansiBrightBlue": "#acaba7",
    "terminal.ansiMagenta": "#788e9f",
    "terminal.ansiBrightMagenta": "#6a98a5",
    "terminal.ansiCyan": "#6ca6bd",
    "terminal.ansiBrightCyan": "#e6e7fa",
    "terminal.ansiWhite": "#e6e7fa",
    "terminal.ansiBrightWhite": "#f6f6ff",
    "list.activeSelectionBackground": "#282523",
    "list.activeSelectionForeground": "#acaba7",
    "list.inactiveSelectionBackground": "#191715",
    "list.hoverBackground": "#181614",
    "list.highlightForeground": "#6ca6bd",
    "list.errorForeground": "#7797b6",
    "list.warningForeground": "#6a98a5",
    "input.background": "#1b1917",
    "input.foreground": "#9f9e9a",
    "input.border": "#353230",
    "input.placeholderForeground": "#6c6a69",
    "inputOption.activeBorder": "#6ca6bd",
    "dropdown.background": "#24211f",
    "dropdown.border": "#353230",
    "badge.background": "#6ca6bd",
    "badge.foreground": "#1d1b19",
    "button.background": "#6ca6bd",
    "button.foreground": "#1d1b19",
    "button.hoverBackground": "#7ab3cb",
    "focusBorder": "#6ca6bd99",
    "scrollbarSlider.background": "#9f9e9a1f",
    "scrollbarSlider.hoverBackground": "#9f9e9a33",
    "scrollbarSlider.activeBackground": "#9f9e9a4c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#6ca6bd",
    "breadcrumb.foreground": "#6c6a69",
    "breadcrumb.focusForeground": "#acaba7",
    "menu.background": "#24211f",
    "menu.foreground": "#9f9e9a",
    "gitDecoration.modifiedResourceForeground": "#6a98a5",
    "gitDecoration.addedResourceForeground": "#809cb4",
    "gitDecoration.deletedResourceForeground": "#7797b6",
    "gitDecoration.untrackedResourceForeground": "#788e9f",
    "gitDecoration.ignoredResourceForeground": "#6c6a69",
    "textLink.foreground": "#6ca6bd",
    "textLink.activeForeground": "#7cb6ce"
  },
  "semanticTokenColors": {
    "function": "#8499a5",
    "method": "#8499a5",
    "class": "#6a98a5",
    "type": "#6a98a5",
    "interface": "#6a98a5",
    "enum": "#6a98a5",
    "string": "#6ca6bd",
    "number": "#6a98a5",
    "keyword": "#809cb4",
    "variable": "#9f9e9a",
    "parameter": "#9f9e9a",
    "property": "#6a98a5",
    "namespace": "#788e9f",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#6c6a69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#797776"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#6ca6bd"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#6ca6bd"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#809cb4"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#9f9e9a"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#8499a5"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#9f9e9a"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#9f9e9a"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#788e9f"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#788e9f"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#7797b6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#6ca6bd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#acaba7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#acaba7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#acaba7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#8499a5"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#acaba7"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#9f9e9a"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6c6a69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#6c6a69"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#809cb4"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#7797b6"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#6a98a5"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#788e9f"
      }
    }
  ]
}