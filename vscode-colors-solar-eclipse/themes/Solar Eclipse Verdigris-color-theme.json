{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Verdigris",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#002324",
    "editor.foreground": "#839590",
    "editorLineNumber.foreground": "#527070",
    "editorLineNumber.activeForeground": "#94a19c",
    "editor.lineHighlightBackground": "#002e2f",
    "editor.selectionBackground": "#0a3738",
    "editor.inactiveSelectionBackground": "#002e2f",
    "editor.selectionHighlightBackground": "#519caa24",
    "editor.wordHighlightBackground": "#519caa1f",
    "editor.wordHighlightStrongBackground": "#519caa2e",
    "editor.findMatchBackground": "#519caa57",
    "editor.findMatchHighlightBackground": "#519caa2e",
    "editorCursor.foreground": "#94a19c",
    "editorWhitespace.foreground": "#103b3c",
    "editorIndentGuide.background1": "#073536",
    "editorIndentGuide.activeIndentGuide1": "#527070",
    "editorRuler.foreground": "#002e2f",
    "editorBracketMatch.background": "#519caa2e",
    "editorBracketMatch.border": "#519caa",
    "editorGutter.modifiedBackground": "#937668",
    "editorGutter.addedBackground": "#9d8f77",
    "editorGutter.deletedBackground": "#6d707e",
    "editorError.foreground": "#6d707e",
    "editorWarning.foreground": "#937668",
    "editorInfo.foreground": "#519caa",
    "editorWidget.background": "#062a2b",
    "editorWidget.border": "#103b3c",
    "editorSuggestWidget.selectedBackground": "#002e2f",
    "editorHoverWidget.background": "#062a2b",
    "editorHoverWidget.border": "#103b3c",
    "peekViewEditor.background": "#002122",
    "peekViewResult.background": "#001a1b",
    "diffEditor.insertedTextBackground": "#9d8f771f",
    "diffEditor.removedTextBackground": "#6d707e1f",
    "sideBar.background": "#001a1b",
    "sideBar.foreground": "#839590",
    "sideBar.border": "#053233",
    "sideBarSectionHeader.background": "#001a1b",
    "sideBarSectionHeader.foreground": "#94a19c",
    "sideBarTitle.foreground": "#94a19c",
    "activityBar.background": "#001a1b",
    "activityBar.foreground": "#94a19c",
    "activityBar.inactiveForeground": "#527070",
    "activityBar.border": "#053233",
    "activityBarBadge.background": "#519caa",
    "activityBarBadge.foreground": "#002324",
    "statusBar.background": "#001a1b",
    "statusBar.foreground": "#839590",
    "statusBar.border": "#053233",
    "statusBar.noFolderBackground": "#001a1b",
    "statusBar.debuggingBackground": "#937668",
    "statusBar.debuggingForeground": "#002324",
    "statusBarItem.remoteBackground": "#519caa",
    "statusBarItem.remoteForeground": "#002324",
    "titleBar.activeBackground": "#001a1b",
    "titleBar.activeForeground": "#839590",
    "titleBar.inactiveBackground": "#001a1b",
    "titleBar.inactiveForeground": "#527070",
    "titleBar.border": "#053233",
    "tab.activeBackground": "#002324",
    "tab.activeForeground": "#94a19c",
    "tab.inactiveBackground": "#001a1b",
    "tab.inactiveForeground": "#527070",
    "tab.border": "#053233",
    "tab.activeBorderTop": "#519caa",
    "editorGroupHeader.tabsBackground": "#001a1b",
    "editorGroupHeader.noTabsBackground": "#001a1b",
    "editorGroup.border": "#053233",
    "panel.background": "#002324",
    "panel.border": "#053233",
    "panelTitle.activeForeground": "#94a19c",
    "panelTitle.inactiveForeground": "#527070",
    "terminal.background": "#002324",
    "terminal.foreground": "#839590",
    "terminalCursor.foreground": "#94a19c",
    "terminal.ansiBlack": "#002e2f",
    "terminal.ansiBrightBlack": "#527070",
    "terminal.ansiRed": "#6d707e",
    "terminal.ansiBrightRed": "#6d707e",
    "terminal.ansiGreen": "#9d8f77",
    "terminal.ansiBrightGreen": "#5e7d7d",
    "terminal.ansiYellow": "#937668",
    "terminal.ansiBrightYellow": "#839590",
    "terminal.ansiBlue": "#84939d",
    "terminal.ansiBrightBlue": "#94a19c",
    "terminal.ansiMagenta": "#57648c",
    "terminal.ansiBrightMagenta": "#937668",
    "terminal.ansiCyan": "#519caa",
    "terminal.ansiBrightCyan": "#f8e5d7",
    "terminal.ansiWhite": "#f8e5d7",
    "terminal.ansiBrightWhite": "#fff5ed",
    "list.activeSelectionBackground": "#002e2f",
    "list.activeSelectionForeground": "#94a19c",
    "list.inactiveSelectionBackground": "#061e1f",
    "list.hoverBackground": "#051d1e",
    "list.highlightForeground": "#519caa",
    "list.errorForeground": "#6d707e",
    "list.warningForeground": "#937668",
    "input.background": "#002122",
    "input.foreground": "#839590",
    "input.border": "#103b3c",
    "input.placeholderForeground": "#527070",
    "inputOption.activeBorder": "#519caa",
    "dropdown.background": "#062a2b",
    "dropdown.border": "#103b3c",
    "badge.background": "#519caa",
    "badge.foreground": "#002324",
    "button.background": "#519caa",
    "button.foreground": "#002324",
    "button.hoverBackground": "#5fa9b8",
    "focusBorder": "#519caa99",
    "scrollbarSlider.background": "#8395901f",
    "scrollbarSlider.hoverBackground": "#83959033",
    "scrollbarSlider.activeBackground": "#8395904c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#519caa",
    "breadcrumb.foreground": "#527070",
    "breadcrumb.focusForeground": "#94a19c",
    "menu.background": "#062a2b",
    "menu.foreground": "#839590",
    "gitDecoration.modifiedResourceForeground": "#937668",
    "gitDecoration.addedResourceForeground": "#9d8f77",
    "gitDecoration.deletedResourceForeground": "#6d707e",
    "gitDecoration.untrackedResourceForeground": "#57648c",
    "gitDecoration.ignoredResourceForeground": "#527070",
    "textLink.foreground": "#519caa",
    "textLink.activeForeground": "#62acba"
  },
  "semanticTokenColors": {
    "function": "#84939d",
    "method": "#84939d",
    "class": "#937668",
    "type": "#937668",
    "interface": "#937668",
    "enum": "#937668",
    "string": "#519caa",
    "number": "#937668",
    "keyword": "#9d8f77",
    "variable": "#839590",
    "parameter": "#839590",
    "property": "#937668",
    "namespace": "#57648c",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#527070",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#5e7d7d"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#519caa"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#519caa"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#9d8f77"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#839590"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#84939d"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#839590"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#839590"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#57648c"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#6d707e"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#57648c"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#6d707e"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#6d707e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#519caa",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#94a19c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#527070"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#94a19c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#94a19c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#84939d"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#94a19c"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#527070"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#839590"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#527070",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#527070"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#9d8f77"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#6d707e"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#937668"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#57648c"
      }
    }
  ]
}