{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Verdigris",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#012324",
    "editor.foreground": "#8b9291",
    "editorLineNumber.foreground": "#5a6e6e",
    "editorLineNumber.activeForeground": "#989f9f",
    "editor.lineHighlightBackground": "#082e2f",
    "editor.selectionBackground": "#133738",
    "editor.inactiveSelectionBackground": "#082e2f",
    "editor.selectionHighlightBackground": "#5899b324",
    "editor.wordHighlightBackground": "#5899b31f",
    "editor.wordHighlightStrongBackground": "#5899b32e",
    "editor.findMatchBackground": "#5899b357",
    "editor.findMatchHighlightBackground": "#5899b32e",
    "editorCursor.foreground": "#989f9f",
    "editorWhitespace.foreground": "#173b3c",
    "editorIndentGuide.background1": "#103536",
    "editorIndentGuide.activeIndentGuide1": "#5a6e6e",
    "editorRuler.foreground": "#082e2f",
    "editorBracketMatch.background": "#5899b32e",
    "editorBracketMatch.border": "#5899b3",
    "editorGutter.modifiedBackground": "#668aa7",
    "editorGutter.addedBackground": "#5f979b",
    "editorGutter.deletedBackground": "#5d89a5",
    "editorError.foreground": "#5d89a5",
    "editorWarning.foreground": "#668aa7",
    "editorInfo.foreground": "#5899b3",
    "editorWidget.background": "#072a2b",
    "editorWidget.border": "#173b3c",
    "editorSuggestWidget.selectedBackground": "#082e2f",
    "editorHoverWidget.background": "#072a2b",
    "editorHoverWidget.border": "#173b3c",
    "peekViewEditor.background": "#002122",
    "peekViewResult.background": "#001a1b",
    "diffEditor.insertedTextBackground": "#5f979b1f",
    "diffEditor.removedTextBackground": "#5d89a51f",
    "sideBar.background": "#001a1b",
    "sideBar.foreground": "#8b9291",
    "sideBar.border": "#0d3233",
    "sideBarSectionHeader.background": "#001a1b",
    "sideBarSectionHeader.foreground": "#989f9f",
    "sideBarTitle.foreground": "#989f9f",
    "activityBar.background": "#001a1b",
    "activityBar.foreground": "#989f9f",
    "activityBar.inactiveForeground": "#5a6e6e",
    "activityBar.border": "#0d3233",
    "activityBarBadge.background": "#5899b3",
    "activityBarBadge.foreground": "#012324",
    "statusBar.background": "#001a1b",
    "statusBar.foreground": "#8b9291",
    "statusBar.border": "#0d3233",
    "statusBar.noFolderBackground": "#001a1b",
    "statusBar.debuggingBackground": "#668aa7",
    "statusBar.debuggingForeground": "#012324",
    "statusBarItem.remoteBackground": "#5899b3",
    "statusBarItem.remoteForeground": "#012324",
    "titleBar.activeBackground": "#001a1b",
    "titleBar.activeForeground": "#8b9291",
    "titleBar.inactiveBackground": "#001a1b",
    "titleBar.inactiveForeground": "#5a6e6e",
    "titleBar.border": "#0d3233",
    "tab.activeBackground": "#012324",
    "tab.activeForeground": "#989f9f",
    "tab.inactiveBackground": "#001a1b",
    "tab.inactiveForeground": "#5a6e6e",
    "tab.border": "#0d3233",
    "tab.activeBorderTop": "#5899b3",
    "editorGroupHeader.tabsBackground": "#001a1b",
    "editorGroupHeader.noTabsBackground": "#001a1b",
    "editorGroup.border": "#0d3233",
    "panel.background": "#012324",
    "panel.border": "#0d3233",
    "panelTitle.activeForeground": "#989f9f",
    "panelTitle.inactiveForeground": "#5a6e6e",
    "terminal.background": "#012324",
    "terminal.foreground": "#8b9291",
    "terminalCursor.foreground": "#989f9f",
    "terminal.ansiBlack": "#082e2f",
    "terminal.ansiBrightBlack": "#5a6e6e",
    "terminal.ansiRed": "#5d89a5",
    "terminal.ansiBrightRed": "#5d89a5",
    "terminal.ansiGreen": "#5f979b",
    "terminal.ansiBrightGreen": "#677b7c",
    "terminal.ansiYellow": "#668aa7",
    "terminal.ansiBrightYellow": "#8b9291",
    "terminal.ansiBlue": "#7b90a6",
    "terminal.ansiBrightBlue": "#989f9f",
    "terminal.ansiMagenta": "#6b83a0",
    "terminal.ansiBrightMagenta": "#668aa7",
    "terminal.ansiCyan": "#5899b3",
    "terminal.ansiBrightCyan": "#f8e5d7",
    "terminal.ansiWhite": "#f8e5d7",
    "terminal.ansiBrightWhite": "#fff5ed",
    "list.activeSelectionBackground": "#082e2f",
    "list.activeSelectionForeground": "#989f9f",
    "list.inactiveSelectionBackground": "#061e1f",
    "list.hoverBackground": "#051d1e",
    "list.highlightForeground": "#5899b3",
    "list.errorForeground": "#5d89a5",
    "list.warningForeground": "#668aa7",
    "input.background": "#002122",
    "input.foreground": "#8b9291",
    "input.border": "#173b3c",
    "input.placeholderForeground": "#5a6e6e",
    "inputOption.activeBorder": "#5899b3",
    "dropdown.background": "#072a2b",
    "dropdown.border": "#173b3c",
    "badge.background": "#5899b3",
    "badge.foreground": "#012324",
    "button.background": "#5899b3",
    "button.foreground": "#012324",
    "button.hoverBackground": "#66a6c1",
    "focusBorder": "#5899b399",
    "scrollbarSlider.background": "#8b92911f",
    "scrollbarSlider.hoverBackground": "#8b929133",
    "scrollbarSlider.activeBackground": "#8b92914c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#5899b3",
    "breadcrumb.foreground": "#5a6e6e",
    "breadcrumb.focusForeground": "#989f9f",
    "menu.background": "#072a2b",
    "menu.foreground": "#8b9291",
    "gitDecoration.modifiedResourceForeground": "#668aa7",
    "gitDecoration.addedResourceForeground": "#5f979b",
    "gitDecoration.deletedResourceForeground": "#5d89a5",
    "gitDecoration.untrackedResourceForeground": "#6b83a0",
    "gitDecoration.ignoredResourceForeground": "#5a6e6e",
    "textLink.foreground": "#5899b3",
    "textLink.activeForeground": "#69a9c3"
  },
  "semanticTokenColors": {
    "function": "#7b90a6",
    "method": "#7b90a6",
    "class": "#668aa7",
    "type": "#668aa7",
    "interface": "#668aa7",
    "enum": "#668aa7",
    "string": "#5899b3",
    "number": "#668aa7",
    "keyword": "#5f979b",
    "variable": "#8b9291",
    "parameter": "#8b9291",
    "property": "#668aa7",
    "namespace": "#6b83a0",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#5a6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#677b7c"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#5899b3"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#5899b3"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#5f979b"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#8b9291"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#7b90a6"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#8b9291"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#8b9291"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#6b83a0"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#5d89a5"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#6b83a0"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#5d89a5"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#5d89a5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#5899b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#989f9f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#5a6e6e"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#989f9f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#989f9f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#7b90a6"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#989f9f"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#5a6e6e"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#8b9291"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#5a6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#5a6e6e"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#5f979b"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#5d89a5"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#668aa7"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#6b83a0"
      }
    }
  ]
}