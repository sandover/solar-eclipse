{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Nocturne",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#001a2d",
    "editor.foreground": "#85939b",
    "editorLineNumber.foreground": "#5f6c7b",
    "editorLineNumber.activeForeground": "#94a0a6",
    "editor.lineHighlightBackground": "#05253a",
    "editor.selectionBackground": "#102d43",
    "editor.inactiveSelectionBackground": "#05253a",
    "editor.selectionHighlightBackground": "#559ab024",
    "editor.wordHighlightBackground": "#559ab01f",
    "editor.wordHighlightStrongBackground": "#559ab02e",
    "editor.findMatchBackground": "#559ab057",
    "editor.findMatchHighlightBackground": "#559ab02e",
    "editorCursor.foreground": "#94a0a6",
    "editorWhitespace.foreground": "#163248",
    "editorIndentGuide.background1": "#0e2b41",
    "editorIndentGuide.activeIndentGuide1": "#5f6c7b",
    "editorRuler.foreground": "#05253a",
    "editorBracketMatch.background": "#559ab02e",
    "editorBracketMatch.border": "#559ab0",
    "editorGutter.modifiedBackground": "#5d8f85",
    "editorGutter.addedBackground": "#a08e77",
    "editorGutter.deletedBackground": "#725d60",
    "editorError.foreground": "#725d60",
    "editorWarning.foreground": "#5d8f85",
    "editorInfo.foreground": "#559ab0",
    "editorWidget.background": "#062034",
    "editorWidget.border": "#163248",
    "editorSuggestWidget.selectedBackground": "#05253a",
    "editorHoverWidget.background": "#062034",
    "editorHoverWidget.border": "#163248",
    "peekViewEditor.background": "#00182a",
    "peekViewResult.background": "#00111e",
    "diffEditor.insertedTextBackground": "#a08e771f",
    "diffEditor.removedTextBackground": "#725d601f",
    "sideBar.background": "#00111e",
    "sideBar.foreground": "#85939b",
    "sideBar.border": "#0b293f",
    "sideBarSectionHeader.background": "#00111e",
    "sideBarSectionHeader.foreground": "#94a0a6",
    "sideBarTitle.foreground": "#94a0a6",
    "activityBar.background": "#00111e",
    "activityBar.foreground": "#94a0a6",
    "activityBar.inactiveForeground": "#5f6c7b",
    "activityBar.border": "#0b293f",
    "activityBarBadge.background": "#559ab0",
    "activityBarBadge.foreground": "#001a2d",
    "statusBar.background": "#00111e",
    "statusBar.foreground": "#85939b",
    "statusBar.border": "#0b293f",
    "statusBar.noFolderBackground": "#00111e",
    "statusBar.debuggingBackground": "#5d8f85",
    "statusBar.debuggingForeground": "#001a2d",
    "statusBarItem.remoteBackground": "#559ab0",
    "statusBarItem.remoteForeground": "#001a2d",
    "titleBar.activeBackground": "#00111e",
    "titleBar.activeForeground": "#85939b",
    "titleBar.inactiveBackground": "#00111e",
    "titleBar.inactiveForeground": "#5f6c7b",
    "titleBar.border": "#0b293f",
    "tab.activeBackground": "#001a2d",
    "tab.activeForeground": "#94a0a6",
    "tab.inactiveBackground": "#00111e",
    "tab.inactiveForeground": "#5f6c7b",
    "tab.border": "#0b293f",
    "tab.activeBorderTop": "#559ab0",
    "editorGroupHeader.tabsBackground": "#00111e",
    "editorGroupHeader.noTabsBackground": "#00111e",
    "editorGroup.border": "#0b293f",
    "panel.background": "#001a2d",
    "panel.border": "#0b293f",
    "panelTitle.activeForeground": "#94a0a6",
    "panelTitle.inactiveForeground": "#5f6c7b",
    "terminal.background": "#001a2d",
    "terminal.foreground": "#85939b",
    "terminalCursor.foreground": "#94a0a6",
    "terminal.ansiBlack": "#05253a",
    "terminal.ansiBrightBlack": "#5f6c7b",
    "terminal.ansiRed": "#725d60",
    "terminal.ansiBrightRed": "#725d60",
    "terminal.ansiGreen": "#a08e77",
    "terminal.ansiBrightGreen": "#6b7988",
    "terminal.ansiYellow": "#5d8f85",
    "terminal.ansiBrightYellow": "#85939b",
    "terminal.ansiBlue": "#83949c",
    "terminal.ansiBrightBlue": "#94a0a6",
    "terminal.ansiMagenta": "#7a5955",
    "terminal.ansiBrightMagenta": "#5d8f85",
    "terminal.ansiCyan": "#559ab0",
    "terminal.ansiBrightCyan": "#e3ebd9",
    "terminal.ansiWhite": "#e3ebd9",
    "terminal.ansiBrightWhite": "#f1f9e7",
    "list.activeSelectionBackground": "#05253a",
    "list.activeSelectionForeground": "#94a0a6",
    "list.inactiveSelectionBackground": "#061622",
    "list.hoverBackground": "#051521",
    "list.highlightForeground": "#559ab0",
    "list.errorForeground": "#725d60",
    "list.warningForeground": "#5d8f85",
    "input.background": "#00182a",
    "input.foreground": "#85939b",
    "input.border": "#163248",
    "input.placeholderForeground": "#5f6c7b",
    "inputOption.activeBorder": "#559ab0",
    "dropdown.background": "#062034",
    "dropdown.border": "#163248",
    "badge.background": "#559ab0",
    "badge.foreground": "#001a2d",
    "button.background": "#559ab0",
    "button.foreground": "#001a2d",
    "button.hoverBackground": "#63a7be",
    "focusBorder": "#559ab099",
    "scrollbarSlider.background": "#85939b1f",
    "scrollbarSlider.hoverBackground": "#85939b33",
    "scrollbarSlider.activeBackground": "#85939b4c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#559ab0",
    "breadcrumb.foreground": "#5f6c7b",
    "breadcrumb.focusForeground": "#94a0a6",
    "menu.background": "#062034",
    "menu.foreground": "#85939b",
    "gitDecoration.modifiedResourceForeground": "#5d8f85",
    "gitDecoration.addedResourceForeground": "#a08e77",
    "gitDecoration.deletedResourceForeground": "#725d60",
    "gitDecoration.untrackedResourceForeground": "#7a5955",
    "gitDecoration.ignoredResourceForeground": "#5f6c7b",
    "textLink.foreground": "#559ab0",
    "textLink.activeForeground": "#66aac0"
  },
  "semanticTokenColors": {
    "function": "#83949c",
    "method": "#83949c",
    "class": "#5d8f85",
    "type": "#5d8f85",
    "interface": "#5d8f85",
    "enum": "#5d8f85",
    "string": "#559ab0",
    "number": "#5d8f85",
    "keyword": "#a08e77",
    "variable": "#85939b",
    "parameter": "#85939b",
    "property": "#5d8f85",
    "namespace": "#7a5955",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#5f6c7b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#6b7988"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#559ab0"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#559ab0"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#a08e77"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#85939b"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#83949c"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#85939b"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#85939b"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#7a5955"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#7a5955"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#725d60",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#559ab0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#94a0a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#94a0a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#94a0a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#83949c"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#94a0a6"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#85939b"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#5f6c7b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#a08e77"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#7a5955"
      }
    }
  ]
}