{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Nocturne",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0c1b28",
    "editor.foreground": "#8a9297",
    "editorLineNumber.foreground": "#5f6c7b",
    "editorLineNumber.activeForeground": "#999fa2",
    "editor.lineHighlightBackground": "#162735",
    "editor.selectionBackground": "#1f2f3e",
    "editor.inactiveSelectionBackground": "#162735",
    "editor.selectionHighlightBackground": "#7a95a124",
    "editor.wordHighlightBackground": "#7a95a11f",
    "editor.wordHighlightStrongBackground": "#7a95a12e",
    "editor.findMatchBackground": "#7a95a157",
    "editor.findMatchHighlightBackground": "#7a95a12e",
    "editorCursor.foreground": "#999fa2",
    "editorWhitespace.foreground": "#233442",
    "editorIndentGuide.background1": "#1d2d3c",
    "editorIndentGuide.activeIndentGuide1": "#5f6c7b",
    "editorRuler.foreground": "#162735",
    "editorBracketMatch.background": "#7a95a12e",
    "editorBracketMatch.border": "#7a95a1",
    "editorGutter.modifiedBackground": "#5b917b",
    "editorGutter.addedBackground": "#a08b66",
    "editorGutter.deletedBackground": "#9b7884",
    "editorError.foreground": "#9b7884",
    "editorWarning.foreground": "#5b917b",
    "editorInfo.foreground": "#7a95a1",
    "editorWidget.background": "#13212f",
    "editorWidget.border": "#233442",
    "editorSuggestWidget.selectedBackground": "#162735",
    "editorHoverWidget.background": "#13212f",
    "editorHoverWidget.border": "#233442",
    "peekViewEditor.background": "#0a1926",
    "peekViewResult.background": "#011320",
    "diffEditor.insertedTextBackground": "#a08b661f",
    "diffEditor.removedTextBackground": "#9b78841f",
    "sideBar.background": "#011320",
    "sideBar.foreground": "#8a9297",
    "sideBar.border": "#1a2b39",
    "sideBarSectionHeader.background": "#011320",
    "sideBarSectionHeader.foreground": "#999fa2",
    "sideBarTitle.foreground": "#999fa2",
    "activityBar.background": "#011320",
    "activityBar.foreground": "#999fa2",
    "activityBar.inactiveForeground": "#5f6c7b",
    "activityBar.border": "#1a2b39",
    "activityBarBadge.background": "#7a95a1",
    "activityBarBadge.foreground": "#0c1b28",
    "statusBar.background": "#011320",
    "statusBar.foreground": "#8a9297",
    "statusBar.border": "#1a2b39",
    "statusBar.noFolderBackground": "#011320",
    "statusBar.debuggingBackground": "#5b917b",
    "statusBar.debuggingForeground": "#0c1b28",
    "statusBarItem.remoteBackground": "#7a95a1",
    "statusBarItem.remoteForeground": "#0c1b28",
    "titleBar.activeBackground": "#011320",
    "titleBar.activeForeground": "#8a9297",
    "titleBar.inactiveBackground": "#011320",
    "titleBar.inactiveForeground": "#5f6c7b",
    "titleBar.border": "#1a2b39",
    "tab.activeBackground": "#0c1b28",
    "tab.activeForeground": "#999fa2",
    "tab.inactiveBackground": "#011320",
    "tab.inactiveForeground": "#5f6c7b",
    "tab.border": "#1a2b39",
    "tab.activeBorderTop": "#7a95a1",
    "editorGroupHeader.tabsBackground": "#011320",
    "editorGroupHeader.noTabsBackground": "#011320",
    "editorGroup.border": "#1a2b39",
    "panel.background": "#0c1b28",
    "panel.border": "#1a2b39",
    "panelTitle.activeForeground": "#999fa2",
    "panelTitle.inactiveForeground": "#5f6c7b",
    "terminal.background": "#0c1b28",
    "terminal.foreground": "#8a9297",
    "terminalCursor.foreground": "#999fa2",
    "terminal.ansiBlack": "#162735",
    "terminal.ansiBrightBlack": "#5f6c7b",
    "terminal.ansiRed": "#9b7884",
    "terminal.ansiBrightRed": "#9b7884",
    "terminal.ansiGreen": "#a08b66",
    "terminal.ansiBrightGreen": "#6b7988",
    "terminal.ansiYellow": "#5b917b",
    "terminal.ansiBrightYellow": "#8a9297",
    "terminal.ansiBlue": "#7991a1",
    "terminal.ansiBrightBlue": "#999fa2",
    "terminal.ansiMagenta": "#8a779d",
    "terminal.ansiBrightMagenta": "#5b917b",
    "terminal.ansiCyan": "#7a95a1",
    "terminal.ansiBrightCyan": "#e3ebd9",
    "terminal.ansiWhite": "#e3ebd9",
    "terminal.ansiBrightWhite": "#f1f9e7",
    "list.activeSelectionBackground": "#162735",
    "list.activeSelectionForeground": "#999fa2",
    "list.inactiveSelectionBackground": "#071724",
    "list.hoverBackground": "#051623",
    "list.highlightForeground": "#7a95a1",
    "list.errorForeground": "#9b7884",
    "list.warningForeground": "#5b917b",
    "input.background": "#0a1926",
    "input.foreground": "#8a9297",
    "input.border": "#233442",
    "input.placeholderForeground": "#5f6c7b",
    "inputOption.activeBorder": "#7a95a1",
    "dropdown.background": "#13212f",
    "dropdown.border": "#233442",
    "badge.background": "#7a95a1",
    "badge.foreground": "#0c1b28",
    "button.background": "#7a95a1",
    "button.foreground": "#0c1b28",
    "button.hoverBackground": "#87a2ae",
    "focusBorder": "#7a95a199",
    "scrollbarSlider.background": "#8a92971f",
    "scrollbarSlider.hoverBackground": "#8a929733",
    "scrollbarSlider.activeBackground": "#8a92974c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#7a95a1",
    "breadcrumb.foreground": "#5f6c7b",
    "breadcrumb.focusForeground": "#999fa2",
    "menu.background": "#13212f",
    "menu.foreground": "#8a9297",
    "gitDecoration.modifiedResourceForeground": "#5b917b",
    "gitDecoration.addedResourceForeground": "#a08b66",
    "gitDecoration.deletedResourceForeground": "#9b7884",
    "gitDecoration.untrackedResourceForeground": "#8a779d",
    "gitDecoration.ignoredResourceForeground": "#5f6c7b",
    "textLink.foreground": "#7a95a1",
    "textLink.activeForeground": "#8aa5b1",
    "textBlockQuote.background": "#162735",
    "textBlockQuote.border": "#5f6c7b",
    "textCodeBlock.background": "#162735",
    "textSeparator.foreground": "#233442"
  },
  "semanticTokenColors": {
    "function": "#7991a1",
    "method": "#7991a1",
    "class": "#5b917b",
    "type": "#5b917b",
    "interface": "#5b917b",
    "enum": "#5b917b",
    "string": "#7a95a1",
    "number": "#5b917b",
    "keyword": "#a08b66",
    "variable": "#8a9297",
    "parameter": "#8a9297",
    "property": "#5b917b",
    "namespace": "#8a779d",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#5f6c7b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#6b7988"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#7a95a1"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#7a95a1"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#a08b66"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#7991a1"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#8a779d"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#9b7884"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#8a779d"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#9b7884"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#9b7884",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#999fa2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#999fa2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#7a95a1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name, markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#7991a1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#999fa2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#999fa2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#7991a1"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#999fa2"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#5f6c7b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#5f6c7b"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#a08b66"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#9b7884"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#5b917b"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#8a779d"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#8ba9ba"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#a69a7c"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name",
      "settings": {
        "foreground": "#a7afb1"
      }
    },
    {
      "scope": "markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#a7afb1"
      }
    },
    {
      "scope": "markup.heading.5, markup.heading.5 entity.name",
      "settings": {
        "foreground": "#999fa2"
      }
    },
    {
      "scope": "markup.heading.6, markup.heading.6 entity.name",
      "settings": {
        "foreground": "#999fa2"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#999fa2"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#8a9297"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#829fae"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#8e9b9d"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#8e9b9d"
      }
    }
  ]
}