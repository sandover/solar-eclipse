{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Nocturne",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#181d33",
    "editor.foreground": "#8a929c",
    "editorLineNumber.foreground": "#676a7a",
    "editorLineNumber.activeForeground": "#979fa8",
    "editor.lineHighlightBackground": "#222840",
    "editor.selectionBackground": "#2b3149",
    "editor.inactiveSelectionBackground": "#222840",
    "editor.selectionHighlightBackground": "#55b2ce24",
    "editor.wordHighlightBackground": "#55b2ce1f",
    "editor.wordHighlightStrongBackground": "#55b2ce2e",
    "editor.findMatchBackground": "#55b2ce57",
    "editor.findMatchHighlightBackground": "#55b2ce2e",
    "editorCursor.foreground": "#979fa8",
    "editorWhitespace.foreground": "#2f354e",
    "editorIndentGuide.background1": "#292e47",
    "editorIndentGuide.activeIndentGuide1": "#676a7a",
    "editorRuler.foreground": "#222840",
    "editorBracketMatch.background": "#55b2ce2e",
    "editorBracketMatch.border": "#55b2ce",
    "editorGutter.modifiedBackground": "#5d8f85",
    "editorGutter.addedBackground": "#a08e77",
    "editorGutter.deletedBackground": "#725d60",
    "editorError.foreground": "#725d60",
    "editorWarning.foreground": "#5d8f85",
    "editorInfo.foreground": "#55b2ce",
    "editorWidget.background": "#1d2138",
    "editorWidget.border": "#2f354e",
    "editorSuggestWidget.selectedBackground": "#222840",
    "editorHoverWidget.background": "#1d2138",
    "editorHoverWidget.border": "#2f354e",
    "peekViewEditor.background": "#161b31",
    "peekViewResult.background": "#151a2f",
    "diffEditor.insertedTextBackground": "#a08e771f",
    "diffEditor.removedTextBackground": "#725d601f",
    "sideBar.background": "#151a2f",
    "sideBar.foreground": "#8a929c",
    "sideBar.border": "#262c45",
    "sideBarSectionHeader.background": "#151a2f",
    "sideBarSectionHeader.foreground": "#979fa8",
    "sideBarTitle.foreground": "#979fa8",
    "activityBar.background": "#151a2f",
    "activityBar.foreground": "#979fa8",
    "activityBar.inactiveForeground": "#676a7a",
    "activityBar.border": "#262c45",
    "activityBarBadge.background": "#55b2ce",
    "activityBarBadge.foreground": "#181d33",
    "statusBar.background": "#151a2f",
    "statusBar.foreground": "#8a929c",
    "statusBar.border": "#262c45",
    "statusBar.noFolderBackground": "#151a2f",
    "statusBar.debuggingBackground": "#5d8f85",
    "statusBar.debuggingForeground": "#181d33",
    "statusBarItem.remoteBackground": "#55b2ce",
    "statusBarItem.remoteForeground": "#181d33",
    "titleBar.activeBackground": "#151a2f",
    "titleBar.activeForeground": "#8a929c",
    "titleBar.inactiveBackground": "#151a2f",
    "titleBar.inactiveForeground": "#676a7a",
    "titleBar.border": "#262c45",
    "tab.activeBackground": "#181d33",
    "tab.activeForeground": "#979fa8",
    "tab.inactiveBackground": "#151a2f",
    "tab.inactiveForeground": "#676a7a",
    "tab.border": "#262c45",
    "tab.activeBorderTop": "#55b2ce",
    "editorGroupHeader.tabsBackground": "#151a2f",
    "editorGroupHeader.noTabsBackground": "#151a2f",
    "editorGroup.border": "#262c45",
    "panel.background": "#181d33",
    "panel.border": "#262c45",
    "panelTitle.activeForeground": "#979fa8",
    "panelTitle.inactiveForeground": "#676a7a",
    "terminal.background": "#181d33",
    "terminal.foreground": "#8a929c",
    "terminalCursor.foreground": "#979fa8",
    "terminal.ansiBlack": "#222840",
    "terminal.ansiBrightBlack": "#676a7a",
    "terminal.ansiRed": "#725d60",
    "terminal.ansiBrightRed": "#725d60",
    "terminal.ansiGreen": "#a08e77",
    "terminal.ansiBrightGreen": "#747688",
    "terminal.ansiYellow": "#5d8f85",
    "terminal.ansiBrightYellow": "#8a929c",
    "terminal.ansiBlue": "#85969e",
    "terminal.ansiBrightBlue": "#979fa8",
    "terminal.ansiMagenta": "#7a5955",
    "terminal.ansiBrightMagenta": "#5d8f85",
    "terminal.ansiCyan": "#55b2ce",
    "terminal.ansiBrightCyan": "#daeddf",
    "terminal.ansiWhite": "#daeddf",
    "terminal.ansiBrightWhite": "#e8fbed",
    "list.activeSelectionBackground": "#222840",
    "list.activeSelectionForeground": "#979fa8",
    "list.inactiveSelectionBackground": "#191e33",
    "list.hoverBackground": "#181d32",
    "list.highlightForeground": "#55b2ce",
    "list.errorForeground": "#725d60",
    "list.warningForeground": "#5d8f85",
    "input.background": "#161b31",
    "input.foreground": "#8a929c",
    "input.border": "#2f354e",
    "input.placeholderForeground": "#676a7a",
    "inputOption.activeBorder": "#55b2ce",
    "dropdown.background": "#1d2138",
    "dropdown.border": "#2f354e",
    "badge.background": "#55b2ce",
    "badge.foreground": "#181d33",
    "button.background": "#55b2ce",
    "button.foreground": "#181d33",
    "button.hoverBackground": "#64c0dc",
    "focusBorder": "#55b2ce99",
    "scrollbarSlider.background": "#8a929c1f",
    "scrollbarSlider.hoverBackground": "#8a929c33",
    "scrollbarSlider.activeBackground": "#8a929c4c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#55b2ce",
    "breadcrumb.foreground": "#676a7a",
    "breadcrumb.focusForeground": "#979fa8",
    "menu.background": "#1d2138",
    "menu.foreground": "#8a929c",
    "gitDecoration.modifiedResourceForeground": "#5d8f85",
    "gitDecoration.addedResourceForeground": "#a08e77",
    "gitDecoration.deletedResourceForeground": "#725d60",
    "gitDecoration.untrackedResourceForeground": "#7a5955",
    "gitDecoration.ignoredResourceForeground": "#676a7a",
    "textLink.foreground": "#55b2ce",
    "textLink.activeForeground": "#67c2df"
  },
  "semanticTokenColors": {
    "function": "#85969e",
    "method": "#85969e",
    "class": "#5d8f85",
    "type": "#5d8f85",
    "interface": "#5d8f85",
    "enum": "#5d8f85",
    "string": "#55b2ce",
    "number": "#5d8f85",
    "keyword": "#a08e77",
    "variable": "#8a929c",
    "parameter": "#8a929c",
    "property": "#5d8f85",
    "namespace": "#7a5955",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#676a7a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#747688"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#55b2ce"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#55b2ce"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#a08e77"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#8a929c"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#85969e"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#8a929c"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#8a929c"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#7a5955"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#7a5955"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#725d60",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#55b2ce",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#979fa8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#979fa8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#85969e"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw",
      "settings": {
        "foreground": "#55b2ce"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#676a7a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#a08e77"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#725d60"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#5d8f85"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#7a5955"
      }
    }
  ]
}