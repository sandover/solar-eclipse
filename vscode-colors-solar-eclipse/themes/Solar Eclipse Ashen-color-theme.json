{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Ashen",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0f181e",
    "editor.foreground": "#889397",
    "editorLineNumber.foreground": "#656b70",
    "editorLineNumber.activeForeground": "#97a0a2",
    "editor.lineHighlightBackground": "#182228",
    "editor.selectionBackground": "#202a31",
    "editor.inactiveSelectionBackground": "#182228",
    "editor.selectionHighlightBackground": "#67a7a624",
    "editor.wordHighlightBackground": "#67a7a61f",
    "editor.wordHighlightStrongBackground": "#67a7a62e",
    "editor.findMatchBackground": "#67a7a657",
    "editor.findMatchHighlightBackground": "#67a7a62e",
    "editorCursor.foreground": "#97a0a2",
    "editorWhitespace.foreground": "#242f35",
    "editorIndentGuide.background1": "#1e282e",
    "editorIndentGuide.activeIndentGuide1": "#656b70",
    "editorRuler.foreground": "#182228",
    "editorBracketMatch.background": "#67a7a62e",
    "editorBracketMatch.border": "#67a7a6",
    "editorGutter.modifiedBackground": "#937469",
    "editorGutter.addedBackground": "#849585",
    "editorGutter.deletedBackground": "#716e64",
    "editorError.foreground": "#716e64",
    "editorWarning.foreground": "#937469",
    "editorInfo.foreground": "#67a7a6",
    "editorWidget.background": "#141c22",
    "editorWidget.border": "#242f35",
    "editorSuggestWidget.selectedBackground": "#182228",
    "editorHoverWidget.background": "#141c22",
    "editorHoverWidget.border": "#242f35",
    "peekViewEditor.background": "#0c161c",
    "peekViewResult.background": "#0a151b",
    "diffEditor.insertedTextBackground": "#8495851f",
    "diffEditor.removedTextBackground": "#716e641f",
    "sideBar.background": "#0a151b",
    "sideBar.foreground": "#889397",
    "sideBar.border": "#1c262c",
    "sideBarSectionHeader.background": "#0a151b",
    "sideBarSectionHeader.foreground": "#97a0a2",
    "sideBarTitle.foreground": "#97a0a2",
    "activityBar.background": "#0a151b",
    "activityBar.foreground": "#97a0a2",
    "activityBar.inactiveForeground": "#656b70",
    "activityBar.border": "#1c262c",
    "activityBarBadge.background": "#67a7a6",
    "activityBarBadge.foreground": "#0f181e",
    "statusBar.background": "#0a151b",
    "statusBar.foreground": "#889397",
    "statusBar.border": "#1c262c",
    "statusBar.noFolderBackground": "#0a151b",
    "statusBar.debuggingBackground": "#937469",
    "statusBar.debuggingForeground": "#0f181e",
    "statusBarItem.remoteBackground": "#67a7a6",
    "statusBarItem.remoteForeground": "#0f181e",
    "titleBar.activeBackground": "#0a151b",
    "titleBar.activeForeground": "#889397",
    "titleBar.inactiveBackground": "#0a151b",
    "titleBar.inactiveForeground": "#656b70",
    "titleBar.border": "#1c262c",
    "tab.activeBackground": "#0f181e",
    "tab.activeForeground": "#97a0a2",
    "tab.inactiveBackground": "#0a151b",
    "tab.inactiveForeground": "#656b70",
    "tab.border": "#1c262c",
    "tab.activeBorderTop": "#67a7a6",
    "editorGroupHeader.tabsBackground": "#0a151b",
    "editorGroupHeader.noTabsBackground": "#0a151b",
    "editorGroup.border": "#1c262c",
    "panel.background": "#0f181e",
    "panel.border": "#1c262c",
    "panelTitle.activeForeground": "#97a0a2",
    "panelTitle.inactiveForeground": "#656b70",
    "terminal.background": "#0f181e",
    "terminal.foreground": "#889397",
    "terminalCursor.foreground": "#97a0a2",
    "terminal.ansiBlack": "#182228",
    "terminal.ansiBrightBlack": "#656b70",
    "terminal.ansiRed": "#716e64",
    "terminal.ansiBrightRed": "#716e64",
    "terminal.ansiGreen": "#849585",
    "terminal.ansiBrightGreen": "#72787d",
    "terminal.ansiYellow": "#937469",
    "terminal.ansiBrightYellow": "#889397",
    "terminal.ansiBlue": "#87838f",
    "terminal.ansiBrightBlue": "#97a0a2",
    "terminal.ansiMagenta": "#785863",
    "terminal.ansiBrightMagenta": "#937469",
    "terminal.ansiCyan": "#67a7a6",
    "terminal.ansiBrightCyan": "#e7ead7",
    "terminal.ansiWhite": "#e7ead7",
    "terminal.ansiBrightWhite": "#f6f8e5",
    "list.activeSelectionBackground": "#182228",
    "list.activeSelectionForeground": "#97a0a2",
    "list.inactiveSelectionBackground": "#10191f",
    "list.hoverBackground": "#0e181e",
    "list.highlightForeground": "#67a7a6",
    "list.errorForeground": "#716e64",
    "list.warningForeground": "#937469",
    "input.background": "#0c161c",
    "input.foreground": "#889397",
    "input.border": "#242f35",
    "input.placeholderForeground": "#656b70",
    "inputOption.activeBorder": "#67a7a6",
    "dropdown.background": "#141c22",
    "dropdown.border": "#242f35",
    "badge.background": "#67a7a6",
    "badge.foreground": "#0f181e",
    "button.background": "#67a7a6",
    "button.foreground": "#0f181e",
    "button.hoverBackground": "#74b5b3",
    "focusBorder": "#67a7a699",
    "scrollbarSlider.background": "#8893971f",
    "scrollbarSlider.hoverBackground": "#88939733",
    "scrollbarSlider.activeBackground": "#8893974c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#67a7a6",
    "breadcrumb.foreground": "#656b70",
    "breadcrumb.focusForeground": "#97a0a2",
    "menu.background": "#141c22",
    "menu.foreground": "#889397",
    "gitDecoration.modifiedResourceForeground": "#937469",
    "gitDecoration.addedResourceForeground": "#849585",
    "gitDecoration.deletedResourceForeground": "#716e64",
    "gitDecoration.untrackedResourceForeground": "#785863",
    "gitDecoration.ignoredResourceForeground": "#656b70",
    "textLink.foreground": "#67a7a6",
    "textLink.activeForeground": "#77b7b6"
  },
  "semanticTokenColors": {
    "function": "#87838f",
    "method": "#87838f",
    "class": "#937469",
    "type": "#937469",
    "interface": "#937469",
    "enum": "#937469",
    "string": "#67a7a6",
    "number": "#937469",
    "keyword": "#849585",
    "variable": "#889397",
    "parameter": "#889397",
    "property": "#937469",
    "namespace": "#785863",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#656b70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#72787d"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#67a7a6"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#67a7a6"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#849585"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#889397"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#87838f"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#889397"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#889397"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#785863"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#716e64"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#785863"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#716e64"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#716e64",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#67a7a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#97a0a2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#97a0a2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#87838f"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw",
      "settings": {
        "foreground": "#67a7a6"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#656b70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#849585"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#716e64"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#937469"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#785863"
      }
    }
  ]
}