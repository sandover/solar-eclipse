{
  "$schema": "vscode://schemas/color-theme",
  "name": "Solar Eclipse Ashen",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0f181e",
    "editor.foreground": "#8f9598",
    "editorLineNumber.foreground": "#656b70",
    "editorLineNumber.activeForeground": "#9da4a7",
    "editor.lineHighlightBackground": "#182228",
    "editor.selectionBackground": "#202a31",
    "editor.inactiveSelectionBackground": "#182228",
    "editor.selectionHighlightBackground": "#8298a024",
    "editor.wordHighlightBackground": "#8298a01f",
    "editor.wordHighlightStrongBackground": "#8298a02e",
    "editor.findMatchBackground": "#8298a057",
    "editor.findMatchHighlightBackground": "#8298a02e",
    "editorCursor.foreground": "#9da4a7",
    "editorWhitespace.foreground": "#242f35",
    "editorIndentGuide.background1": "#1e282e",
    "editorIndentGuide.activeIndentGuide1": "#656b70",
    "editorRuler.foreground": "#182228",
    "editorBracketMatch.background": "#8298a02e",
    "editorBracketMatch.border": "#8298a0",
    "editorGutter.modifiedBackground": "#649796",
    "editorGutter.addedBackground": "#6e9ba4",
    "editorGutter.deletedBackground": "#6a93ac",
    "editorError.foreground": "#6a93ac",
    "editorWarning.foreground": "#649796",
    "editorInfo.foreground": "#8298a0",
    "editorWidget.background": "#161e25",
    "editorWidget.border": "#242f35",
    "editorSuggestWidget.selectedBackground": "#182228",
    "editorHoverWidget.background": "#161e25",
    "editorHoverWidget.border": "#242f35",
    "peekViewEditor.background": "#0c161c",
    "peekViewResult.background": "#041017",
    "diffEditor.insertedTextBackground": "#6e9ba41f",
    "diffEditor.removedTextBackground": "#6a93ac1f",
    "sideBar.background": "#041017",
    "sideBar.foreground": "#8f9598",
    "sideBar.border": "#1c262c",
    "sideBarSectionHeader.background": "#041017",
    "sideBarSectionHeader.foreground": "#9da4a7",
    "sideBarTitle.foreground": "#9da4a7",
    "activityBar.background": "#041017",
    "activityBar.foreground": "#9da4a7",
    "activityBar.inactiveForeground": "#656b70",
    "activityBar.border": "#1c262c",
    "activityBarBadge.background": "#8298a0",
    "activityBarBadge.foreground": "#0f181e",
    "statusBar.background": "#041017",
    "statusBar.foreground": "#8f9598",
    "statusBar.border": "#1c262c",
    "statusBar.noFolderBackground": "#041017",
    "statusBar.debuggingBackground": "#649796",
    "statusBar.debuggingForeground": "#0f181e",
    "statusBarItem.remoteBackground": "#8298a0",
    "statusBarItem.remoteForeground": "#0f181e",
    "titleBar.activeBackground": "#041017",
    "titleBar.activeForeground": "#8f9598",
    "titleBar.inactiveBackground": "#041017",
    "titleBar.inactiveForeground": "#656b70",
    "titleBar.border": "#1c262c",
    "tab.activeBackground": "#0f181e",
    "tab.activeForeground": "#9da4a7",
    "tab.inactiveBackground": "#041017",
    "tab.inactiveForeground": "#656b70",
    "tab.border": "#1c262c",
    "tab.activeBorderTop": "#8298a0",
    "editorGroupHeader.tabsBackground": "#041017",
    "editorGroupHeader.noTabsBackground": "#041017",
    "editorGroup.border": "#1c262c",
    "panel.background": "#0f181e",
    "panel.border": "#1c262c",
    "panelTitle.activeForeground": "#9da4a7",
    "panelTitle.inactiveForeground": "#656b70",
    "terminal.background": "#0f181e",
    "terminal.foreground": "#8f9598",
    "terminalCursor.foreground": "#9da4a7",
    "terminal.ansiBlack": "#182228",
    "terminal.ansiBrightBlack": "#656b70",
    "terminal.ansiRed": "#6a93ac",
    "terminal.ansiBrightRed": "#6a93ac",
    "terminal.ansiGreen": "#6e9ba4",
    "terminal.ansiBrightGreen": "#72787d",
    "terminal.ansiYellow": "#649796",
    "terminal.ansiBrightYellow": "#8f9598",
    "terminal.ansiBlue": "#8098a1",
    "terminal.ansiBrightBlue": "#9da4a7",
    "terminal.ansiMagenta": "#718d9a",
    "terminal.ansiBrightMagenta": "#649796",
    "terminal.ansiCyan": "#8298a0",
    "terminal.ansiBrightCyan": "#e7ead7",
    "terminal.ansiWhite": "#e7ead7",
    "terminal.ansiBrightWhite": "#f6f8e5",
    "list.activeSelectionBackground": "#182228",
    "list.activeSelectionForeground": "#9da4a7",
    "list.inactiveSelectionBackground": "#0b151b",
    "list.hoverBackground": "#09141a",
    "list.highlightForeground": "#8298a0",
    "list.errorForeground": "#6a93ac",
    "list.warningForeground": "#649796",
    "input.background": "#0c161c",
    "input.foreground": "#8f9598",
    "input.border": "#242f35",
    "input.placeholderForeground": "#656b70",
    "inputOption.activeBorder": "#8298a0",
    "dropdown.background": "#161e25",
    "dropdown.border": "#242f35",
    "badge.background": "#8298a0",
    "badge.foreground": "#0f181e",
    "button.background": "#8298a0",
    "button.foreground": "#0f181e",
    "button.hoverBackground": "#8fa5ad",
    "focusBorder": "#8298a099",
    "scrollbarSlider.background": "#8f95981f",
    "scrollbarSlider.hoverBackground": "#8f959833",
    "scrollbarSlider.activeBackground": "#8f95984c",
    "widget.shadow": "#00000060",
    "progressBar.background": "#8298a0",
    "breadcrumb.foreground": "#656b70",
    "breadcrumb.focusForeground": "#9da4a7",
    "menu.background": "#161e25",
    "menu.foreground": "#8f9598",
    "gitDecoration.modifiedResourceForeground": "#649796",
    "gitDecoration.addedResourceForeground": "#6e9ba4",
    "gitDecoration.deletedResourceForeground": "#6a93ac",
    "gitDecoration.untrackedResourceForeground": "#718d9a",
    "gitDecoration.ignoredResourceForeground": "#656b70",
    "textLink.foreground": "#8298a0",
    "textLink.activeForeground": "#92a8b0",
    "textBlockQuote.background": "#182228",
    "textBlockQuote.border": "#656b70",
    "textCodeBlock.background": "#182228",
    "textSeparator.foreground": "#242f35"
  },
  "semanticTokenColors": {
    "function": "#8098a1",
    "method": "#8098a1",
    "class": "#649796",
    "type": "#649796",
    "interface": "#649796",
    "enum": "#649796",
    "string": "#8298a0",
    "number": "#649796",
    "keyword": "#6e9ba4",
    "variable": "#8f9598",
    "parameter": "#8f9598",
    "property": "#649796",
    "namespace": "#718d9a",
    "*.declaration": {
      "fontStyle": ""
    }
  },
  "tokenColors": [
    {
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#656b70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation, meta.brace, punctuation.separator, punctuation.terminator",
      "settings": {
        "foreground": "#72787d"
      }
    },
    {
      "scope": "string, string.quoted, punctuation.definition.string",
      "settings": {
        "foreground": "#8298a0"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#8298a0"
      }
    },
    {
      "scope": "constant.numeric, constant.language, constant.character",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "constant.other, support.constant",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#6e9ba4"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call.generic",
      "settings": {
        "foreground": "#8098a1"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "variable, variable.other, meta.definition.variable",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "variable.language, variable.other.constant",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag",
      "settings": {
        "foreground": "#718d9a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "meta.preprocessor, keyword.control.directive, meta.preprocessor.string",
      "settings": {
        "foreground": "#6a93ac"
      }
    },
    {
      "scope": "meta.decorator, punctuation.decorator, entity.name.function.decorator",
      "settings": {
        "foreground": "#718d9a"
      }
    },
    {
      "scope": "invalid, invalid.illegal",
      "settings": {
        "foreground": "#6a93ac"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#6a93ac",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#9da4a7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading, entity.name.section",
      "settings": {
        "foreground": "#9da4a7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#8298a0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name, markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#8098a1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "punctuation.definition.heading",
      "settings": {
        "foreground": "#656b70"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#9da4a7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#9da4a7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#8098a1"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#9da4a7"
      }
    },
    {
      "scope": "punctuation.definition.raw",
      "settings": {
        "foreground": "#656b70"
      }
    },
    {
      "scope": "markup.fenced_code.block, markup.raw.block",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#656b70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#656b70"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#6e9ba4"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#6a93ac"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#649796"
      }
    },
    {
      "scope": "entity.name.namespace, entity.name.module",
      "settings": {
        "foreground": "#718d9a"
      }
    },
    {
      "scope": "markup.heading.1, markup.heading.1 entity.name",
      "settings": {
        "foreground": "#98aab2"
      }
    },
    {
      "scope": "markup.heading.2, markup.heading.2 entity.name",
      "settings": {
        "foreground": "#a79d87"
      }
    },
    {
      "scope": "markup.heading.3, markup.heading.3 entity.name",
      "settings": {
        "foreground": "#adb0ab"
      }
    },
    {
      "scope": "markup.heading.4, markup.heading.4 entity.name",
      "settings": {
        "foreground": "#adb0ab"
      }
    },
    {
      "scope": "markup.heading.5, markup.heading.5 entity.name",
      "settings": {
        "foreground": "#9da4a7"
      }
    },
    {
      "scope": "markup.heading.6, markup.heading.6 entity.name",
      "settings": {
        "foreground": "#9da4a7"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#9da4a7"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#8f9598"
      }
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#8da5a7"
      }
    },
    {
      "scope": "markup.inline.raw, markup.raw.inline",
      "settings": {
        "foreground": "#969f92"
      }
    },
    {
      "scope": "markup.list punctuation.definition.list, punctuation.definition.list.begin",
      "settings": {
        "foreground": "#969f92"
      }
    }
  ]
}